/target
/.idea/

# Calibration and validation working data. Fetched or generated by the
# harnesses in crates/skipzone-lab/src/bin; regenerate it, do not commit it.
/corpus/

# Knowledge-graph output.
/graphify-out/

# Staged release artefacts: built binaries, archives and checksums, assembled
# for upload to a GitHub release. Reproduce them from a tag, do not commit them.
/release/

# Git notes
upload.txt
# Snapshot test output next to the committed references: the new render, the
# diff and the backup an update leaves behind.
/app/tests/snapshots/*.new.png
/app/tests/snapshots/*.diff.png
/app/tests/snapshots/*.old.png
